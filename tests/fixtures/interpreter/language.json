      "features": [
        "container.value",
        "container.mutation",
        "value.identity"
      ]
    },
    {
      "id": "closure",
      "stage": "B",
      "source": "def outer(value):\n    def inner():\n        return value\n    return inner\nprint(outer(7)())",
      "stdout": "7\n",
      "features": [
        "function.value",
        "scope.closure"
      ]
    },
    {
      "id": "exception-finally",
      "stage": "B",
      "source": "try:\n    raise ValueError('bad')\nexcept ValueError as error:\n    print(str(error))\nfinally:\n    print('done')",
      "stdout": "bad\ndone\n",
      "features": [
        "exception.unwind"
      ]
    },
    {
      "id": "argument-default",
      "stage": "B",
      "source": "def add(value, amount=2):\n    return value + amount\nprint(add(3), add(amount=4, value=3))",
      "stdout": "5 7\n",
      "features": [
        "function.arguments",
        "function.defaults"
      ]
    },
    {
      "id": "division-error",
